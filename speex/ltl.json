            "call:speex_decoder_ctl(SPEEX_SET_HANDLER)",
            "call:speex_decoder_ctl(SPEEX_SET_USER_HANDLER)",
            "call:speex_decode",
            "call:speex_decode_int",
            "call:speex_decoder_destroy",
            "call:speex_inband_handler",
            "call:speex_std_enh_request_handler"
          ]
        }
      },
      "examples": [
        {
          "events": [
            "call:speex_decoder_init",
            "ok:speex_decoder_init",
            "call:speex_decode",
            "fail:speex_decode",
            "call:speex_decoder_destroy",
            "ok:speex_decoder_destroy"
          ],
          "allowed": true,
          "reason": "normal lifetime"
        },
        {
          "events": [
            "call:speex_decode_int"
          ],
          "allowed": false,
          "reason": "no decoder"
        },
        {
          "events": [
            "call:speex_decoder_init",
            "ok:speex_decoder_init",
            "call:speex_decoder_destroy",
            "ok:speex_decoder_destroy",
            "call:speex_decoder_destroy"
          ],
          "allowed": false,
          "reason": "double destroy"
        }
      ]
    },
