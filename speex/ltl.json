{
  "properties": [
    {
      "id": "encoder_lifecycle",
      "rule": "speex.h: speex_encode*/speex_encoder_ctl take the state from speex_encoder_init; speex_encoder_destroy frees it. The in-band mode/vbr request handlers are given the encoder as their data pointer (speex_callbacks.h). The harness keeps one encoder.",
      "formula": "(!x_use W x_new) & G(x_end -> X(!x_use W x_new))",
      "apis": [
        "speex_encode",
        "speex_encode_int",
        "speex_encoder_ctl",
        "speex_encoder_destroy",
        "speex_encoder_init",
        "speex_std_high_mode_request_handler",
        "speex_std_low_mode_request_handler",
        "speex_std_mode_request_handler",
        "speex_std_vbr_quality_request_handler",
        "speex_std_vbr_request_handler"
      ],
      "predicates": {
        "x_new": {
          "meaning": "the object was created",
          "events": [
            "ok:speex_encoder_init"
          ]
        },
        "x_end": {
          "meaning": "the object is about to be released",
          "events": [
            "call:speex_encoder_destroy"
          ]
        },
        "x_use": {
          "meaning": "a routine taking the object is about to be called",
          "events": [
            "call:speex_encoder_ctl",
            "call:speex_encode",
            "call:speex_encode_int",
            "call:speex_encoder_destroy",
            "call:speex_std_mode_request_handler",
            "call:speex_std_low_mode_request_handler",
            "call:speex_std_high_mode_request_handler",
            "call:speex_std_vbr_request_handler",
            "call:speex_std_vbr_quality_request_handler"
          ]
        }
      },
      "examples": [
        {
          "events": [
            "call:speex_encoder_init",
            "ok:speex_encoder_init",
            "call:speex_encoder_ctl",
            "fail:speex_encoder_ctl",
            "call:speex_encode_int",
            "ok:speex_encode_int",
            "call:speex_encoder_destroy",
            "ok:speex_encoder_destroy"
          ],
          "allowed": true,
          "reason": "normal lifetime"
        },
        {
          "events": [
            "call:speex_encode"
          ],
          "allowed": false,
          "reason": "no encoder"
        },
        {
          "events": [
            "call:speex_encoder_init",
            "ok:speex_encoder_init",
            "call:speex_encoder_destroy",
            "ok:speex_encoder_destroy",
            "call:speex_encoder_ctl"
          ],
          "allowed": false,
          "reason": "use after destroy"
        }
      ]
    },
    {
