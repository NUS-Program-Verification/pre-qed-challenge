    {
      "id": "stereo_state_outlives_decoder_handler",
      "rule": "speex_callbacks.h: SPEEX_SET_HANDLER stores the SpeexCallback, including its data pointer (the stereo state), inside the decoder; the decoder calls it whenever an in-band stereo request arrives. The stereo state must not be destroyed while a decoder that holds it lives.",
      "formula": "G(handler_set -> X(!stereo_free W dec_free))",
      "apis": [
        "speex_decoder_ctl(SPEEX_SET_HANDLER)",
        "speex_stereo_state_destroy",
        "speex_decoder_destroy"
      ],
      "predicates": {
        "handler_set": {
          "meaning": "the decoder accepted the stereo handler",
          "events": [
            "ok:speex_decoder_ctl(SPEEX_SET_HANDLER)"
          ]
        },
        "stereo_free": {
          "meaning": "the stereo state is about to be destroyed",
          "events": [
            "call:speex_stereo_state_destroy"
          ]
        },
        "dec_free": {
          "meaning": "the decoder holding the callback is destroyed",
          "events": [
            "call:speex_decoder_destroy"
          ]
        }
      },
      "examples": [
        {
          "events": [
            "call:speex_decoder_ctl(SPEEX_SET_HANDLER)",
            "ok:speex_decoder_ctl(SPEEX_SET_HANDLER)",
            "call:speex_decoder_destroy",
            "ok:speex_decoder_destroy",
            "call:speex_stereo_state_destroy",
            "ok:speex_stereo_state_destroy"
          ],
          "allowed": true,
          "reason": "decoder released first"
        },
        {
          "events": [
            "call:speex_decoder_ctl(SPEEX_SET_HANDLER)",
            "ok:speex_decoder_ctl(SPEEX_SET_HANDLER)",
            "call:speex_stereo_state_destroy"
          ],
          "allowed": false,
          "reason": "decoder still points at the stereo state"
        }
      ]
    },
    {
      "id": "header_buffers_freed_once",
      "rule": "speex_header.h: speex_header_to_packet and speex_packet_to_header return memory that speex_header_free releases. The harness reports both frees as speex_header_free; since they are separate objects the rule is only that a free follows an allocation.",
      "formula": "!h_free W h_new",
      "apis": [
        "speex_header_to_packet",
        "speex_packet_to_header",
        "speex_header_free"
      ],
      "predicates": {
        "h_new": {
          "meaning": "a header buffer was allocated",
          "events": [
            "ok:speex_header_to_packet",
            "ok:speex_packet_to_header"
          ]
        },
        "h_free": {
          "meaning": "speex_header_free is about to be called",
          "events": [
            "call:speex_header_free"
          ]
        }
      },
      "examples": [
        {
          "events": [
            "call:speex_header_to_packet",
            "ok:speex_header_to_packet",
            "call:speex_header_free",
            "ok:speex_header_free"
          ],
          "allowed": true,
          "reason": "allocate then free"
        },
        {
          "events": [
            "call:speex_header_free"
          ],
          "allowed": false,
          "reason": "nothing allocated"
        }
      ]
    }
  ]
}