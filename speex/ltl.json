            "call:speex_bits_pack",
            "call:speex_bits_unpack_signed",
            "call:speex_bits_unpack_unsigned",
            "call:speex_bits_peek_unsigned",
            "call:speex_bits_peek",
            "call:speex_bits_advance",
            "call:speex_bits_remaining",
            "call:speex_bits_nbytes",
            "call:speex_bits_insert_terminator",
            "call:speex_encode",
