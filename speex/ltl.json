    {
      "id": "stereo_state_lifecycle",
      "rule": "speex_stereo.h: speex_decode_stereo*, speex_stereo_state_reset and the stereo request handler take the state from speex_stereo_state_init; speex_stereo_state_destroy frees it.",
      "formula": "(!x_use W x_new) & G(x_end -> X(!x_use W x_new))",
      "apis": [
        "speex_decode_stereo",
        "speex_decode_stereo_int",
        "speex_decoder_ctl(SPEEX_SET_HANDLER)",
        "speex_std_stereo_request_handler",
        "speex_stereo_state_destroy",
        "speex_stereo_state_init",
        "speex_stereo_state_reset"
      ],
      "predicates": {
        "x_new": {
          "meaning": "the object was created",
          "events": [
            "ok:speex_stereo_state_init"
          ]
        },
        "x_end": {
