      "examples": [
        {
          "events": [
            "call:VTCP_connect",
            "ok:VTCP_connect",
            "call:VTCP_connected",
            "ok:VTCP_connected",
            "call:VTCP_read",
            "ok:VTCP_read",
            "call:VTCP_close",
            "ok:VTCP_close",
