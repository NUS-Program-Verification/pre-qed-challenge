          "reason": "init, update, final, init again"
        },
        {
          "events": [
            "call:VSHA256_Update"
          ],
          "allowed": false,
          "reason": "no init"
        },
        {
          "events": [
            "call:VSHA256_Init",
            "ok:VSHA256_Init",
            "call:VSHA256_Final",
            "ok:VSHA256_Final",
            "call:VSHA256_Update"
