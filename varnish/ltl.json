{
  "properties": [
    {
      "id": "vsb_lifecycle",
      "rule": "vsb.h / vsb.c: every VSB_* routine asserts assert_VSB_integrity(s), so it needs a buffer from VSB_new_auto or VSB_init; VSB_destroy and VSB_fini release it. The harness keeps one VSB. VRE_error, VRE_quote and VRE_sub (vre.c: CHECK_OBJ_NOTNULL(vsb, VSB_MAGIC), then VSB_printf / VSB_cat / VSB_bcat) write into it too.",
      "formula": "(!s_use W s_new) & G(s_end -> X(!s_use W s_new))",
      "apis": [
        "VSB_new_auto",
        "VSB_init",
        "VSB_bcat",
        "VSB_cat",
        "VSB_putc",
        "VSB_printf",
        "VSB_vprintf",
        "VSB_quote",
        "VSB_quote_pfx",
        "VSB_indent",
        "VBT_format",
        "VSB_finish",
        "VSB_data",
        "VSB_tofile",
        "VSB_clear",
        "VSB_len",
        "VSB_error",
        "VSB_destroy",
        "VSB_fini",
        "VRE_error",
        "VRE_quote",
        "VRE_sub"
      ],
      "predicates": {
        "s_new": {
          "meaning": "a VSB was created",
          "events": [
            "ok:VSB_new_auto",
            "ok:VSB_init"
          ]
        },
        "s_end": {
          "meaning": "the VSB is about to be released",
          "events": [
            "call:VSB_destroy",
            "call:VSB_fini"
          ]
        },
        "s_use": {
          "meaning": "a routine taking the VSB is about to be called",
          "events": [
            "call:VSB_bcat",
            "call:VSB_cat",
            "call:VSB_putc",
            "call:VSB_printf",
            "call:VSB_vprintf",
            "call:VSB_quote",
            "call:VSB_quote_pfx",
            "call:VSB_indent",
            "call:VBT_format",
            "call:VSB_finish",
            "call:VSB_data",
            "call:VSB_tofile",
            "call:VSB_clear",
            "call:VSB_len",
            "call:VSB_error",
            "call:VSB_destroy",
            "call:VSB_fini",
            "call:VRE_error",
            "call:VRE_quote",
            "call:VRE_sub"
          ]
        }
      },
      "examples": [
        {
          "events": [
            "call:VSB_new_auto",
            "ok:VSB_new_auto",
            "call:VSB_cat",
            "ok:VSB_cat",
            "call:VSB_finish",
            "ok:VSB_finish",
            "call:VSB_destroy",
            "ok:VSB_destroy",
            "call:VSB_init",
            "ok:VSB_init",
            "call:VSB_putc"
          ],
          "allowed": true,
          "reason": "uses sit between create and release"
        },
        {
          "events": [
            "call:VSB_cat"
          ],
          "allowed": false,
          "reason": "no VSB"
        },
        {
          "events": [
            "call:VSB_new_auto",
            "ok:VSB_new_auto",
            "call:VSB_destroy",
            "ok:VSB_destroy",
            "call:VSB_len"
          ],
          "allowed": false,
          "reason": "use after destroy"
        }
      ]
    },
    {
      "id": "vsb_write_until_finish",
      "rule": "vsb.c: append routines and VSB_finish assert_VSB_state(s, 0), i.e. not finished; VSB_data and VSB_tofile assert_VSB_state(s, VSB_FINISHED). VSB_finish sets the FINISHED flag even when it returns -1; VSB_clear clears it; a new buffer starts unfinished. VRE_error, VRE_quote and VRE_sub append to the VSB.",
      "formula": "G(s_finish -> X(!s_write W s_reopen)) & (!s_read W s_finish) & G(s_reopen -> X(!s_read W s_finish))",
      "apis": [
        "VSB_new_auto",
        "VSB_init",
        "VSB_clear",
        "VSB_bcat",
        "VSB_cat",
        "VSB_putc",
        "VSB_printf",
        "VSB_vprintf",
        "VSB_quote",
        "VSB_quote_pfx",
        "VSB_indent",
        "VBT_format",
        "VSB_finish",
        "VSB_data",
        "VSB_tofile",
        "VRE_error",
        "VRE_quote",
        "VRE_sub"
      ],
      "predicates": {
        "s_finish": {
          "meaning": "VSB_finish is about to be called",
          "events": [
            "call:VSB_finish"
          ]
        },
        "s_reopen": {
          "meaning": "the buffer is unfinished again (new or cleared)",
          "events": [
            "ok:VSB_new_auto",
            "ok:VSB_init",
            "call:VSB_clear"
          ]
        },
        "s_write": {
          "meaning": "an append routine or VSB_finish is about to be called",
          "events": [
            "call:VSB_bcat",
            "call:VSB_cat",
            "call:VSB_putc",
            "call:VSB_printf",
            "call:VSB_vprintf",
            "call:VSB_quote",
            "call:VSB_quote_pfx",
            "call:VSB_indent",
            "call:VBT_format",
            "call:VSB_finish",
            "call:VRE_error",
            "call:VRE_quote",
            "call:VRE_sub"
          ]
        },
        "s_read": {
          "meaning": "VSB_data or VSB_tofile is about to be called",
          "events": [
            "call:VSB_data",
            "call:VSB_tofile"
          ]
        }
      },
      "examples": [
        {
          "events": [
            "call:VSB_new_auto",
            "ok:VSB_new_auto",
            "call:VSB_printf",
            "ok:VSB_printf",
            "call:VSB_finish",
            "fail:VSB_finish",
            "call:VSB_data",
            "ok:VSB_data",
            "call:VSB_clear",
            "ok:VSB_clear",
            "call:VSB_putc",
            "ok:VSB_putc"
          ],
          "allowed": true,
          "reason": "finish (even failing) then read, clear then write again"
        },
        {
          "events": [
            "call:VSB_new_auto",
            "ok:VSB_new_auto",
            "call:VSB_finish",
            "ok:VSB_finish",
            "call:VSB_cat"
          ],
          "allowed": false,
          "reason": "append after finish"
        },
        {
          "events": [
            "call:VSB_new_auto",
            "ok:VSB_new_auto",
            "call:VSB_finish",
            "ok:VSB_finish",
            "call:VSB_finish"
          ],
          "allowed": false,
          "reason": "finish twice"
        },
        {
          "events": [
            "call:VSB_new_auto",
            "ok:VSB_new_auto",
            "call:VSB_data"
          ],
          "allowed": false,
          "reason": "data before finish"
        }
      ]
    },
    {
      "id": "vav_argv_ownership",
      "rule": "vav.h: VAV_Parse / VAV_ParseTxt return a malloc'd argv the caller releases with VAV_Free; freeing it again or freeing without one is a double/invalid free. The harness holds one argv.",
      "formula": "(!a_free W a_ok) & G(a_free -> X(!a_free W a_ok))",
      "apis": [
        "VAV_Parse",
        "VAV_ParseTxt",
        "VAV_Free"
      ],
      "predicates": {
        "a_ok": {
          "meaning": "a parse returned an argv",
          "events": [
            "ok:VAV_Parse",
            "ok:VAV_ParseTxt",
            "fail:VAV_Parse",
            "fail:VAV_ParseTxt"
          ]
        },
        "a_free": {
          "meaning": "VAV_Free is about to be called",
          "events": [
            "call:VAV_Free"
          ]
        }
      },
      "examples": [
        {
          "events": [
            "call:VAV_Parse",
            "fail:VAV_Parse",
            "call:VAV_Free",
            "ok:VAV_Free",
            "call:VAV_ParseTxt",
            "ok:VAV_ParseTxt",
            "call:VAV_Free"
          ],
          "allowed": true,
          "reason": "an argv with an error in argv[0] still has to be freed"
        },
        {
          "events": [
            "call:VAV_Free"
          ],
          "allowed": false,
          "reason": "nothing to free"
        },
        {
          "events": [
            "call:VAV_Parse",
            "ok:VAV_Parse",
            "call:VAV_Free",
            "ok:VAV_Free",
            "call:VAV_Free"
          ],
          "allowed": false,
          "reason": "double free"
        }
      ]
    },
    {
