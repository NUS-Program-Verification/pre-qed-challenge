            "call:VTCP_nonblocking",
            "call:VTCP_linger",
            "call:VTCP_check_hup",
            "call:VTCP_set_read_timeout",
            "call:VTCP_read",
            "call:VTCP_myname",
            "call:VTCP_hisname",
            "call:VTCP_my_suckaddr",
            "call:VSA_getsockname",
            "call:VSA_getpeername",
            "call:VTCP_connected",
            "call:VTCP_close"
