{
  "properties": [
    {
      "id": "instance_lifecycle",
      "rule": "clap_host.h: an instance exists once omx_clap_host_open, omx_clap_host_open_timed, omx_clap_host_open_entry or omx_clap_host_create answered 0 with *out set, and is gone at omx_clap_host_close ('Destroy the instance ... and drop its binary reference'). Every other call here takes that instance. The harness keeps one instance and closes it by a record.",
      "formula": "(!i_use W i_new) & G(i_close -> X(!i_use W i_new))",
      "apis": [
        "omx_clap_host_open", "omx_clap_host_open_timed", "omx_clap_host_open_entry", "omx_clap_host_create",
        "omx_clap_host_close",
