    {
      "id": "bind_aux_while_stopped",
      "rule": "clap_host.h: omx_clap_host_bind_aux_input and _bind_aux_output are 'Control thread, while the instance is not running (never published, or unpublished)' (src/clap_host.c bind_aux returns -1: 'unpublish first'): an armed or processing stage refuses them. A restart, a rate change and a deactivate stop the stage, so a bind after one is fine.",
      "formula": "G(pub -> X(!b_aux W (a_round | i_new)))",
      "apis": [
        "omx_clap_host_bind_aux_input", "omx_clap_host_bind_aux_output", "omx_clap_host_publish",
        "omx_clap_host_unpublish", "omx_clap_host_stop"
      ],
      "predicates": {
        "pub": {
          "meaning": "the stage was armed",
          "events": [
            "call:omx_clap_host_publish",
            "call:omx_clap_host_publish_role",
            "call:omx_clap_host_arm"
          ]
        },
        "b_aux": {
          "meaning": "an auxiliary port's buffers are about to be bound",
          "events": [
            "call:omx_clap_host_bind_aux_input",
            "call:omx_clap_host_bind_aux_output"
          ]
        },
        "a_round": {
          "meaning": "the stage is no longer running",
          "events": [
            "ok:omx_clap_host_unpublish",
            "call:omx_clap_host_stop",
            "ok:omx_clap_host_restart",
            "ok:omx_clap_host_set_rate",
            "ok:omx_clap_host_deactivate",
            "call:omx_clap_host_close"
          ]
        },
        "i_new": {
          "meaning": "another instance was created",
          "events": [
            "ok:omx_clap_host_open",
            "ok:omx_clap_host_open_timed",
            "ok:omx_clap_host_open_entry",
            "ok:omx_clap_host_create"
          ]
        }
      },
      "examples": [
        {
          "events": [
            "call:omx_clap_host_activate", "ok:omx_clap_host_activate",
            "call:omx_clap_host_bind_aux_input", "ok:omx_clap_host_bind_aux_input",
            "call:omx_clap_host_publish", "ok:omx_clap_host_publish",
            "call:omx_clap_host_unpublish", "ok:omx_clap_host_unpublish",
            "call:omx_clap_host_bind_aux_output", "ok:omx_clap_host_bind_aux_output"
          ],
          "allowed": true,
          "reason": "bound while never published, then after the unpublish"
        },
        {
          "events": [
            "call:omx_clap_host_activate", "ok:omx_clap_host_activate",
            "call:omx_clap_host_publish", "ok:omx_clap_host_publish",
            "call:omx_clap_host_bind_aux_input", "fail:omx_clap_host_bind_aux_input"
          ],
          "allowed": false,
          "reason": "bound while the stage is armed"
        },
        {
          "events": [
            "call:omx_clap_host_activate", "ok:omx_clap_host_activate",
            "call:omx_clap_host_publish", "ok:omx_clap_host_publish",
            "call:omx_clap_host_activate", "ok:omx_clap_host_activate"
          ],
          "allowed": true,
          "reason": "no auxiliary bind in the trace"
        }
      ]
    }
  ]
}
