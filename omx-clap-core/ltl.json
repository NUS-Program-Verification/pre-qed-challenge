      "examples": [
        {
          "events": [
            "call:omx_clap_host_open", "ok:omx_clap_host_open",
            "call:omx_clap_host_activate", "ok:omx_clap_host_activate",
            "call:omx_clap_host_param_count", "ok:omx_clap_host_param_count",
            "call:omx_clap_host_close", "ok:omx_clap_host_close"
          ],
          "allowed": true,
          "reason": "uses sit between a successful open and the close"
        },
        {
          "events": ["call:omx_clap_host_activate", "ok:omx_clap_host_activate"],
          "allowed": false,
          "reason": "no instance"
        },
        {
          "events": ["call:omx_clap_host_open", "fail:omx_clap_host_open", "call:omx_clap_host_tick"],
          "allowed": false,
          "reason": "the open was refused, there is no instance"
        },
        {
          "events": [
            "call:omx_clap_host_open", "ok:omx_clap_host_open",
            "call:omx_clap_host_close", "ok:omx_clap_host_close",
            "call:omx_clap_host_latency"
          ],
          "allowed": false,
          "reason": "use after close"
        }
      ]
    },
    {
      "id": "activate_deactivate",
      "rule": "clap_host.h: omx_clap_host_activate is 'Activate at rate for blocks up to max_block' of a plugin that is not active (src/clap_host.c:2908 refuses an active one, -1), and omx_clap_host_deactivate is the only call that makes it inactive again. A restart and a rate change deactivate and activate on their own, so they bracket the activation they replace. The instance closed and opened again starts a new bracket.",
      "formula": "G(a_act -> X(!a_act W (a_deact | i_close | i_new)))",
      "apis": [
        "omx_clap_host_activate", "omx_clap_host_deactivate", "omx_clap_host_restart",
        "omx_clap_host_set_rate", "omx_clap_host_close"
      ],
      "predicates": {
        "a_act": {
          "meaning": "the instance was activated",
          "events": ["ok:omx_clap_host_activate"]
        },
        "a_deact": {
          "meaning": "the instance is inactive again: deactivated, or deactivated and activated by a restart or a rate change",
          "events": [
            "ok:omx_clap_host_deactivate",
            "ok:omx_clap_host_restart",
            "ok:omx_clap_host_set_rate"
          ]
        },
        "i_close": {
          "meaning": "omx_clap_host_close is about to destroy the instance",
          "events": ["call:omx_clap_host_close"]
        },
        "i_new": {
          "meaning": "another instance was created",
          "events": [
            "ok:omx_clap_host_open",
            "ok:omx_clap_host_open_timed",
            "ok:omx_clap_host_open_entry",
            "ok:omx_clap_host_create"
          ]
        }
      },
      "examples": [
        {
          "events": [
            "call:omx_clap_host_open", "ok:omx_clap_host_open",
            "call:omx_clap_host_activate", "ok:omx_clap_host_activate",
            "call:omx_clap_host_deactivate", "ok:omx_clap_host_deactivate",
            "call:omx_clap_host_activate", "ok:omx_clap_host_activate"
          ],
          "allowed": true,
          "reason": "deactivated before the second activate"
        },
        {
          "events": [
            "call:omx_clap_host_open", "ok:omx_clap_host_open",
            "call:omx_clap_host_activate", "ok:omx_clap_host_activate",
            "call:omx_clap_host_activate", "ok:omx_clap_host_activate"
          ],
          "allowed": false,
          "reason": "activate on an active instance"
        },
        {
          "events": [
            "call:omx_clap_host_open", "ok:omx_clap_host_open",
            "call:omx_clap_host_activate", "ok:omx_clap_host_activate",
            "call:omx_clap_host_restart", "ok:omx_clap_host_restart",
            "call:omx_clap_host_activate", "ok:omx_clap_host_activate"
          ],
          "allowed": true,
          "reason": "a restart deactivates and activates again"
        },
        {
          "events": [
            "call:omx_clap_host_activate", "ok:omx_clap_host_activate",
            "call:omx_clap_host_publish", "ok:omx_clap_host_publish",
            "call:omx_clap_host_activate", "ok:omx_clap_host_activate"
          ],
          "allowed": false,
          "reason": "a publish in between does not deactivate the instance"
        }
      ]
    },
    {
      "id": "publish_when_active",
      "rule": "clap_host.h: omx_clap_host_publish, omx_clap_host_publish_role and omx_clap_host_arm arm the stage omx_clap_host_activate bound ('Publish: the stage is ARMED'), so the instance must be active; the stage a deactivate tears down cannot be armed again until the next activate. The harness guards the four this way too: the armed stage of an inactive instance has no plugin for omx_clap_take_state to start.",
      "formula": "(!pub W a_act) & G(a_deact -> X(!pub W (a_act | i_new)))",
      "apis": [
        "omx_clap_host_publish", "omx_clap_host_publish_role", "omx_clap_host_arm",
        "omx_clap_host_activate", "omx_clap_host_deactivate"
      ],
      "predicates": {
        "pub": {
          "meaning": "the stage is about to be armed",
          "events": [
            "call:omx_clap_host_publish",
            "call:omx_clap_host_publish_role",
            "call:omx_clap_host_arm"
          ]
        },
        "a_act": {
          "meaning": "the instance was activated",
          "events": ["ok:omx_clap_host_activate"]
        },
        "a_deact": {
          "meaning": "the instance is inactive again",
          "events": [
            "ok:omx_clap_host_deactivate",
            "ok:omx_clap_host_restart",
            "ok:omx_clap_host_set_rate"
          ]
        },
        "i_new": {
          "meaning": "another instance was created",
          "events": [
            "ok:omx_clap_host_open",
            "ok:omx_clap_host_open_timed",
            "ok:omx_clap_host_open_entry",
            "ok:omx_clap_host_create"
          ]
        }
      },
      "examples": [
        {
          "events": [
            "call:omx_clap_host_activate", "ok:omx_clap_host_activate",
            "call:omx_clap_host_publish", "ok:omx_clap_host_publish",
            "call:omx_clap_host_unpublish", "ok:omx_clap_host_unpublish",
            "call:omx_clap_host_arm", "ok:omx_clap_host_arm",
            "call:omx_clap_host_deactivate", "ok:omx_clap_host_deactivate"
          ],
          "allowed": true,
          "reason": "armed only while the instance is active"
        },
        {
          "events": ["call:omx_clap_host_publish", "ok:omx_clap_host_publish"],
          "allowed": false,
          "reason": "armed with no activate before it"
        },
        {
          "events": [
            "call:omx_clap_host_activate", "ok:omx_clap_host_activate",
            "call:omx_clap_host_deactivate", "ok:omx_clap_host_deactivate",
            "call:omx_clap_host_arm", "ok:omx_clap_host_arm"
          ],
          "allowed": false,
          "reason": "armed after the deactivate tore the stage down"
        },
        {
          "events": [
            "call:omx_clap_host_activate", "ok:omx_clap_host_activate",
            "call:omx_clap_host_deactivate", "ok:omx_clap_host_deactivate",
            "call:omx_clap_host_activate", "ok:omx_clap_host_activate",
            "call:omx_clap_host_publish_role", "ok:omx_clap_host_publish_role"
          ],
          "allowed": true,
          "reason": "activated again first"
        }
      ]
    },
    {
      "id": "audio_role_take_release",
      "rule": "clap_host.h: omx_clap_host_take_role takes the audio role from whoever holds it and records in `role` what to give back; omx_clap_host_release_role gives it back. The harness keeps one role and takes it once, so a take is matched by the release before the next take.",
      "formula": "(!r_release W r_take) & G(r_take -> X(!r_take W (r_release | i_close | i_new)))",
      "apis": ["omx_clap_host_take_role", "omx_clap_host_release_role", "omx_clap_host_close"],
      "predicates": {
        "r_take": {
          "meaning": "the control thread is about to take the audio role",
          "events": ["call:omx_clap_host_take_role"]
        },
        "r_release": {
          "meaning": "the audio role is about to be given back",
          "events": ["call:omx_clap_host_release_role"]
        },
        "i_close": {
          "meaning": "omx_clap_host_close is about to destroy the instance",
          "events": ["call:omx_clap_host_close"]
        },
        "i_new": {
          "meaning": "another instance was created",
          "events": [
            "ok:omx_clap_host_open",
            "ok:omx_clap_host_open_timed",
            "ok:omx_clap_host_open_entry",
            "ok:omx_clap_host_create"
          ]
        }
      },
      "examples": [
        {
          "events": [
            "call:omx_clap_host_take_role", "ok:omx_clap_host_take_role",
            "call:omx_clap_host_release_role", "ok:omx_clap_host_release_role"
          ],
          "allowed": true,
          "reason": "taken and given back"
        },
        {
          "events": ["call:omx_clap_host_release_role", "ok:omx_clap_host_release_role"],
          "allowed": false,
          "reason": "released a role never taken"
        },
        {
          "events": [
            "call:omx_clap_host_take_role", "ok:omx_clap_host_take_role",
            "call:omx_clap_host_take_role", "ok:omx_clap_host_take_role"
          ],
          "allowed": false,
          "reason": "taken twice without a release"
        }
      ]
    },
    {
      "id": "binary_lifecycle",
      "rule": "clap_host.h: omx_clap_host_binary_open returns a plugin file that omx_clap_host_binary_close closes, 'once every instance created from it is destroyed'; omx_clap_host_binary_count, _descriptor, omx_clap_host_presets and omx_clap_host_create take it. The harness keeps one binary and guards the premature close.",
      "formula": "(!b_use W b_new) & G(b_close -> X(!b_use W b_new)) & G(i_create -> X(!b_close W i_close))",
      "apis": [
        "omx_clap_host_binary_open", "omx_clap_host_binary_close", "omx_clap_host_binary_count",
        "omx_clap_host_binary_descriptor", "omx_clap_host_presets", "omx_clap_host_create",
        "omx_clap_host_close"
      ],
      "predicates": {
        "b_new": {
          "meaning": "a plugin file was opened",
          "events": ["ok:omx_clap_host_binary_open"]
        },
        "b_close": {
          "meaning": "omx_clap_host_binary_close is about to close it",
          "events": ["call:omx_clap_host_binary_close"]
        },
        "b_use": {
          "meaning": "a routine that takes the plugin file is about to be called",
          "events": [
            "call:omx_clap_host_binary_close",
            "call:omx_clap_host_binary_count",
            "call:omx_clap_host_binary_descriptor",
            "call:omx_clap_host_presets",
            "call:omx_clap_host_create"
          ]
        },
        "i_create": {
          "meaning": "an instance was created from the plugin file",
          "events": ["ok:omx_clap_host_create"]
        },
        "i_close": {
          "meaning": "that instance was destroyed",
          "events": ["call:omx_clap_host_close"]
        }
      },
      "examples": [
        {
          "events": [
            "call:omx_clap_host_binary_open", "ok:omx_clap_host_binary_open",
            "call:omx_clap_host_binary_count", "ok:omx_clap_host_binary_count",
            "call:omx_clap_host_binary_close", "ok:omx_clap_host_binary_close"
          ],
          "allowed": true,
          "reason": "counted between the open and the close"
        },
        {
          "events": ["call:omx_clap_host_binary_count"],
          "allowed": false,
          "reason": "no plugin file open"
        },
        {
          "events": [
            "call:omx_clap_host_binary_open", "ok:omx_clap_host_binary_open",
            "call:omx_clap_host_binary_close", "ok:omx_clap_host_binary_close",
            "call:omx_clap_host_binary_descriptor"
          ],
          "allowed": false,
          "reason": "use after close"
        },
        {
          "events": [
            "call:omx_clap_host_binary_open", "ok:omx_clap_host_binary_open",
            "call:omx_clap_host_create", "ok:omx_clap_host_create",
            "call:omx_clap_host_close", "ok:omx_clap_host_close",
            "call:omx_clap_host_binary_close", "ok:omx_clap_host_binary_close"
          ],
          "allowed": true,
          "reason": "the instance closed before the file"
        },
        {
          "events": [
            "call:omx_clap_host_binary_open", "ok:omx_clap_host_binary_open",
            "call:omx_clap_host_create", "ok:omx_clap_host_create",
            "call:omx_clap_host_binary_close", "ok:omx_clap_host_binary_close"
