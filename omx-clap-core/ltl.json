        "omx_clap_host_meter_values", "omx_clap_host_voice_info", "omx_clap_host_resource_hints",
        "omx_clap_host_tail", "omx_clap_host_note_name_count", "omx_clap_host_note_name",
        "omx_clap_host_note_names_changed", "omx_clap_host_note_ports_rescanned",
        "omx_clap_host_ports_rescanned", "omx_clap_host_request_layout", "omx_clap_host_tick",
        "omx_clap_host_log_take", "omx_clap_host_track_info_set", "omx_clap_host_remote_controls_changed",
        "omx_clap_host_set_render", "omx_clap_host_set_tempo", "omx_clap_host_set_transport",
        "omx_clap_host_bind_aux_input", "omx_clap_host_bind_aux_output"
      ],
      "predicates": {
