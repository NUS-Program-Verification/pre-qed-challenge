      "formula": "(!mod W (big_ok & X(!mod W big_ok))) & (!str W big_ok)",
      "apis": [
        "bigint::bigint",
        "bigint::operator%",
        "bigint::to_string",
        "bigint::operator&=",
        "bigint::operator|=",
        "bigint::operator^=",
