          "events": [
            "call:bigint::to_string",
            "call:bigint::operator(bool)",
            "call:bigint::operator(double)",
            "call:bigint::operator(long_double)",
            "call:bigint::operator(int64_t)",
            "call:bigint::operator!",
            "call:bigint::operator++",
            "call:bigint::operator--",
            "call:bigint::to_string_hex",
            "call:babs",
            "call:bpow",
            "call:bigint::operator<<",
            "call:bigint::operator>>",
            "call:bsqrt"
          ]
        }
      },
      "examples": [
        {
          "events": [
            "call:bigint::bigint",
            "ok:bigint::bigint",
            "call:bigint::bigint",
