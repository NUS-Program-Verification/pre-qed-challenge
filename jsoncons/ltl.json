      "id": "schema_before_validate",
      "rule": "jsonschema.hpp / json_schema.hpp:71-180: is_valid, validate, walk and operator= are members of the schema object returned by make_json_schema; make_json_schema throws schema_error for an invalid schema, leaving none.",
      "formula": "(!validate W schema_ok) & G(schema_fail -> X(!validate W schema_ok))",
      "apis": [
        "jsonschema::make_json_schema",
        "json_schema::is_valid",
        "json_schema::validate",
        "json_schema::validate(throw)",
        "json_schema::walk",
        "json_schema::operator="
      ],
      "predicates": {
        "schema_ok": {
          "meaning": "a schema was compiled",
          "events": [
            "ok:jsonschema::make_json_schema"
          ]
        },
        "schema_fail": {
          "meaning": "compiling a new schema failed (the harness drops the old one first)",
          "events": [
            "fail:jsonschema::make_json_schema"
          ]
        },
        "validate": {
          "meaning": "a json_schema member (is_valid, validate, walk, operator=) is about to be called",
          "events": [
            "call:json_schema::is_valid",
            "call:json_schema::validate",
            "call:json_schema::validate(throw)",
            "call:json_schema::walk",
            "call:json_schema::operator="
          ]
        }
      },
      "examples": [
        {
          "events": [
            "call:jsonschema::make_json_schema",
            "ok:jsonschema::make_json_schema",
            "call:json_schema::is_valid",
            "ok:json_schema::is_valid"
          ],
          "allowed": true,
          "reason": "compiled first"
        },
        {
          "events": [
            "call:json_schema::is_valid"
          ],
          "allowed": false,
          "reason": "no schema"
        },
        {
          "events": [
            "call:jsonschema::make_json_schema",
            "fail:jsonschema::make_json_schema",
            "call:json_schema::is_valid"
          ],
          "allowed": false,
          "reason": "compilation failed"
        }
      ]
    },
