        "json_object_get_userdata",
        "json_object_int_inc",
        "json_object_is_type",
        "json_object_iter_peek_value",
        "json_object_object_add",
        "json_object_object_add_ex",
        "json_object_object_del",
        "json_object_object_get",
        "json_object_object_get_ex",
        "json_object_put",
        "json_object_set_boolean",
