{
  "properties": [
    {
      "id": "root_lifecycle",
      "rule": "json_object.h: json_object_put drops the caller's reference; with the harness holding the only reference the tree is freed, and every routine taking the tree is use-after-free until a parser or file loader returns a new one. json_patch_apply and json_pointer_set may replace *base, so they produce a root too.",
      "formula": "(!root_use W root_ok) & G(root_put -> X(!root_use W root_ok))",
      "apis": [
        "json_c_visit",
        "json_object_array_add",
        "json_object_array_bsearch",
        "json_object_array_del_idx",
        "json_object_array_get_idx",
        "json_object_array_insert_idx",
        "json_object_array_length",
        "json_object_array_put_idx",
        "json_object_array_put_with_idx_limit_cb",
        "json_object_array_shrink",
        "json_object_array_sort",
        "json_object_deep_copy",
        "json_object_equal",
        "json_object_from_fd",
        "json_object_from_fd_ex",
        "json_object_from_file",
        "json_object_get_array",
        "json_object_get_object",
        "json_object_iter_begin",
        "json_object_iter_end",
        "json_object_object_add",
        "json_object_object_add_ex",
        "json_object_object_del",
        "json_object_object_get",
        "json_object_object_get_ex",
        "json_object_object_length",
        "json_object_put",
        "json_object_to_fd",
        "json_object_to_file",
        "json_object_to_file_ext",
        "json_object_to_json_string",
        "json_object_to_json_string_ext",
        "json_object_to_json_string_length",
        "json_patch_apply",
        "json_pointer_get",
        "json_pointer_getf",
        "json_pointer_set",
        "json_pointer_set_with_cb",
        "json_pointer_set_with_limit_index",
        "json_pointer_setf",
        "json_tokener_parse",
        "json_tokener_parse_ex",
        "json_tokener_parse_verbose"
      ],
      "predicates": {
        "root_ok": {
          "meaning": "a parser or loader returned a non-NULL tree",
          "events": [
            "ok:json_tokener_parse",
            "ok:json_tokener_parse_verbose",
            "ok:json_tokener_parse_ex",
            "ok:json_object_from_file",
            "ok:json_object_from_fd",
            "ok:json_object_from_fd_ex"
          ]
        },
        "root_put": {
          "meaning": "json_object_put on the tree",
          "events": [
            "call:json_object_put"
          ]
        },
        "root_use": {
          "meaning": "a routine taking the tree is about to be called",
          "events": [
            "call:json_object_to_file",
            "call:json_object_to_file_ext",
            "call:json_object_to_fd",
            "call:json_object_to_json_string",
            "call:json_object_to_json_string_ext",
            "call:json_object_to_json_string_length",
            "call:json_object_put",
            "call:json_object_deep_copy",
            "call:json_object_object_add",
            "call:json_object_object_add_ex",
            "call:json_object_array_add",
            "call:json_object_array_put_idx",
            "call:json_object_array_insert_idx",
            "call:json_object_array_put_with_idx_limit_cb",
            "call:json_pointer_set",
            "call:json_pointer_setf",
            "call:json_pointer_set_with_limit_index",
            "call:json_pointer_set_with_cb",
            "call:json_pointer_get",
            "call:json_pointer_getf",
            "call:json_object_object_get",
            "call:json_object_object_get_ex",
            "call:json_object_object_length",
            "call:json_object_object_del",
            "call:json_object_get_object",
            "call:json_object_array_length",
            "call:json_object_array_get_idx",
            "call:json_object_array_del_idx",
            "call:json_object_array_shrink",
            "call:json_object_array_sort",
            "call:json_object_array_bsearch",
            "call:json_object_get_array",
            "call:json_object_equal",
            "call:json_c_visit",
            "call:json_patch_apply",
            "call:json_object_iter_begin",
            "call:json_object_iter_end"
          ]
        }
      },
      "examples": [
        {
          "events": [
            "call:json_tokener_parse",
            "ok:json_tokener_parse",
            "call:json_object_to_json_string",
            "ok:json_object_to_json_string",
            "call:json_object_put",
            "ok:json_object_put",
            "call:json_object_from_file",
            "ok:json_object_from_file",
            "call:json_object_array_length"
          ],
          "allowed": true,
          "reason": "uses sit between a successful parse and put"
        },
        {
          "events": [
            "call:json_object_to_json_string"
          ],
          "allowed": false,
          "reason": "no tree"
        },
        {
          "events": [
            "call:json_tokener_parse",
            "fail:json_tokener_parse",
            "call:json_object_put"
          ],
          "allowed": false,
          "reason": "parse returned NULL"
        },
        {
          "events": [
            "call:json_tokener_parse",
            "ok:json_tokener_parse",
            "call:json_object_put",
            "ok:json_object_put",
            "call:json_c_visit"
          ],
          "allowed": false,
          "reason": "use after put"
        }
      ]
    },
    {
      "id": "item_ownership",
      "rule": "json_object.h: json_object_new_* and json_object_get return a reference the caller owns. json_object_object_add*, json_object_array_add/put_idx/insert_idx and json_pointer_set* take over that reference on success ('the reference count of val is not incremented'); the caller must not pass it again until it owns a new object. The harness keeps one loose object.",
      "formula": "(!item_use W item_owned) & G(item_given -> X(!item_use W item_owned))",
      "apis": [
        "json_object_array_add",
        "json_object_array_bsearch",
        "json_object_array_insert_idx",
        "json_object_array_put_idx",
        "json_object_array_put_with_idx_limit_cb",
        "json_object_deep_copy",
        "json_object_equal",
        "json_object_get",
        "json_object_new_array",
        "json_object_new_array_ext",
        "json_object_new_boolean",
        "json_object_new_double",
        "json_object_new_double_s",
        "json_object_new_int",
        "json_object_new_int64",
        "json_object_new_null",
        "json_object_new_object",
        "json_object_new_string",
        "json_object_new_string_len",
        "json_object_new_uint64",
        "json_object_object_add",
        "json_object_object_add_ex",
        "json_patch_apply",
        "json_pointer_set",
        "json_pointer_set_with_cb",
        "json_pointer_set_with_limit_index",
        "json_pointer_setf"
      ],
      "predicates": {
        "item_owned": {
          "meaning": "a constructor, deep copy or json_object_get returned an owned reference",
          "events": [
            "ok:json_object_new_object",
            "ok:json_object_new_array",
            "ok:json_object_new_null",
            "ok:json_object_new_array_ext",
            "ok:json_object_new_boolean",
            "ok:json_object_new_int",
            "ok:json_object_new_int64",
            "ok:json_object_new_uint64",
            "ok:json_object_new_double",
            "ok:json_object_new_double_s",
            "ok:json_object_new_string",
            "ok:json_object_new_string_len",
            "ok:json_object_deep_copy",
            "ok:json_object_get"
          ]
        },
        "item_given": {
          "meaning": "an add or set accepted the object and now owns it",
          "events": [
            "ok:json_object_object_add",
            "ok:json_object_object_add_ex",
            "ok:json_object_array_add",
            "ok:json_object_array_put_idx",
            "ok:json_object_array_insert_idx",
            "ok:json_object_array_put_with_idx_limit_cb",
            "ok:json_pointer_set",
            "ok:json_pointer_setf",
            "ok:json_pointer_set_with_limit_index",
            "ok:json_pointer_set_with_cb"
          ]
        },
        "item_use": {
          "meaning": "a routine taking the loose object is about to be called",
          "events": [
            "call:json_object_object_add",
            "call:json_object_object_add_ex",
            "call:json_object_array_add",
            "call:json_object_array_put_idx",
            "call:json_object_array_insert_idx",
            "call:json_object_array_put_with_idx_limit_cb",
            "call:json_pointer_set",
            "call:json_pointer_setf",
            "call:json_pointer_set_with_limit_index",
            "call:json_pointer_set_with_cb",
            "call:json_object_array_bsearch",
            "call:json_object_equal",
            "call:json_patch_apply"
          ]
        }
      },
      "examples": [
        {
          "events": [
            "call:json_object_new_int",
            "ok:json_object_new_int",
            "call:json_object_array_add",
            "fail:json_object_array_add",
            "call:json_object_object_add",
            "ok:json_object_object_add",
            "call:json_object_new_null",
            "ok:json_object_new_null",
            "call:json_object_equal"
          ],
          "allowed": true,
          "reason": "failed add keeps ownership; after the successful add a new object is created before the next use"
        },
        {
          "events": [
            "call:json_object_array_add"
          ],
          "allowed": false,
          "reason": "nothing owned"
        },
        {
          "events": [
            "call:json_object_new_int",
            "ok:json_object_new_int",
            "call:json_object_array_add",
            "ok:json_object_array_add",
            "call:json_object_array_add"
          ],
          "allowed": false,
          "reason": "same reference added twice"
        },
        {
          "events": [
            "call:json_object_new_string",
            "ok:json_object_new_string",
            "call:json_pointer_set",
            "ok:json_pointer_set",
            "call:json_object_equal"
          ],
          "allowed": false,
          "reason": "pointer set consumed the reference"
        }
      ]
    },
    {
      "id": "borrowed_child_validity",
      "rule": "json_object.h: lookups (json_object_object_get, json_object_array_get_idx, json_pointer_get, iterator peek) return a borrowed pointer owned by the tree ('no reference count is incremented'). Any mutation of the tree or dropping the tree may free or move it, so it must be looked up again before further use.",
      "formula": "(!child_use W child_ok) & G(tree_mutated -> X(!child_use W child_ok))",
      "apis": [
        "json_object_array_add",
        "json_object_array_bsearch",
