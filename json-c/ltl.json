          "events": [
            "call:json_object_set_serializer",
            "call:json_object_set_userdata",
            "call:json_object_get_userdata",
            "call:json_object_double_to_json_string",
            "call:json_object_get",
            "call:json_object_get_type",
            "call:json_object_is_type",
            "call:json_object_get_boolean",
            "call:json_object_get_int",
            "call:json_object_get_int64",
            "call:json_object_get_uint64",
            "call:json_object_get_double",
            "call:json_object_get_string",
            "call:json_object_get_string_len",
            "call:json_object_set_boolean",
            "call:json_object_set_int",
            "call:json_object_set_int64",
            "call:json_object_set_uint64",
            "call:json_object_set_double",
            "call:json_object_set_string",
            "call:json_object_set_string_len",
            "call:json_object_int_inc"
          ]
        },
        "tree_mutated": {
