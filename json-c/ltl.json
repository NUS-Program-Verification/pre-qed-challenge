    {
      "id": "tokener_lifecycle",
      "rule": "json_tokener.h: json_tokener_parse_ex, set_flags, reset, get_error, get_parse_end take a tokener from json_tokener_new/new_ex; json_tokener_free releases it. The harness keeps one tokener.",
      "formula": "(!tok_use W tok_ok) & G(tok_free -> X(!tok_use W tok_ok))",
      "apis": [
        "json_tokener_new",
        "json_tokener_new_ex",
        "json_tokener_set_flags",
        "json_tokener_parse_ex",
        "json_tokener_get_error",
        "json_tokener_get_parse_end",
        "json_tokener_reset",
        "json_tokener_free"
      ],
      "predicates": {
        "tok_ok": {
          "meaning": "a tokener was allocated",
          "events": [
            "ok:json_tokener_new",
            "ok:json_tokener_new_ex"
          ]
        },
        "tok_free": {
          "meaning": "json_tokener_free is about to be called",
          "events": [
            "call:json_tokener_free"
          ]
        },
        "tok_use": {
          "meaning": "a routine taking the tokener is about to be called",
          "events": [
            "call:json_tokener_set_flags",
            "call:json_tokener_parse_ex",
            "call:json_tokener_get_error",
            "call:json_tokener_get_parse_end",
            "call:json_tokener_reset",
            "call:json_tokener_free"
          ]
        }
      },
      "examples": [
        {
          "events": [
            "call:json_tokener_new",
            "ok:json_tokener_new",
            "call:json_tokener_parse_ex",
            "fail:json_tokener_parse_ex",
            "call:json_tokener_reset",
            "ok:json_tokener_reset",
            "call:json_tokener_free",
            "ok:json_tokener_free"
          ],
          "allowed": true,
          "reason": "normal lifecycle"
        },
        {
          "events": [
            "call:json_tokener_parse_ex"
          ],
          "allowed": false,
          "reason": "no tokener"
        },
        {
          "events": [
            "call:json_tokener_new",
            "ok:json_tokener_new",
            "call:json_tokener_free",
            "ok:json_tokener_free",
            "call:json_tokener_free"
          ],
          "allowed": false,
          "reason": "double free"
        }
      ]
    },
