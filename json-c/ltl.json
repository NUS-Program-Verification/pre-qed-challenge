    {
      "id": "lh_table_lifecycle",
      "rule": "linkhash.h: lh_table_insert takes the table returned by lh_kptr_table_new ('On error, a null pointer is returned'), lh_entry_prev takes an entry of that table, and lh_table_free 'Free a linkhash table'. Nothing may touch the table before a successful create or after the free. The harness keeps one table.",
      "formula": "(!lh_use W lh_ok) & G(lh_free -> X(!lh_use W lh_ok))",
      "apis": [
