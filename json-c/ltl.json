        "json_object_set_serializer",
        "json_object_set_string",
        "json_object_set_string_len",
        "json_object_set_uint64",
        "json_object_set_userdata",
        "json_patch_apply",
        "json_pointer_get",
        "json_pointer_getf",
        "json_pointer_set",
        "json_pointer_set_with_cb",
        "json_pointer_set_with_limit_index",
        "json_pointer_setf"
      ],
      "predicates": {
