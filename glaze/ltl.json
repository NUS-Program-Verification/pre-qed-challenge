    {
      "id": "json_stream_reader_lifecycle",
      "rule": "json/json_stream.hpp:36-48: json_stream_reader is constructed from a stream it reads from (it keeps it in its basic_istream_buffer, core/istream_buffer.hpp:56-80); read_next (json_stream.hpp:52), begin (151) and end (152) are members of that reader, so a reader must have been constructed before any of them. The harness keeps the reader together with its std::istringstream.",
      "formula": "!x_use W x_new",
      "apis": [
        "json_stream_reader::json_stream_reader",
        "json_stream_reader::read_next",
        "json_stream_reader::begin",
        "json_stream_reader::end"
      ],
      "predicates": {
        "x_new": {
          "meaning": "a reader was constructed over a stream",
          "events": [
            "ok:json_stream_reader::json_stream_reader"
          ]
        },
        "x_use": {
          "meaning": "the object is used",
          "events": [
            "call:json_stream_reader::read_next",
            "call:json_stream_reader::begin",
            "call:json_stream_reader::end"
          ]
        }
      },
      "examples": [
        {
          "events": [
            "call:json_stream_reader::json_stream_reader",
            "ok:json_stream_reader::json_stream_reader",
            "call:json_stream_reader::read_next",
            "fail:json_stream_reader::read_next"
          ],
          "allowed": true,
          "reason": "construct, then read (end_reached is a failure result)"
        },
        {
          "events": [
            "call:json_stream_reader::read_next"
          ],
          "allowed": false,
          "reason": "no reader"
        },
        {
          "events": [
            "call:json_stream_reader::begin",
            "ok:json_stream_reader::begin",
            "call:json_stream_reader::json_stream_reader",
            "ok:json_stream_reader::json_stream_reader"
          ],
          "allowed": false,
          "reason": "iterating before the reader exists"
        }
      ]
    },
    {
      "id": "pool_lifecycle",
      "rule": "thread/threadpool.hpp:20-22: glz::pool starts its worker threads in its constructor; emplace_back (74,116) queues a job on those workers and wait (159) blocks until the queue of that pool is empty, so both need a constructed pool. ~pool (167) finishes the queued work.",
      "formula": "!x_use W x_new",
      "apis": [
        "pool::pool",
        "pool::emplace_back",
        "pool::wait"
      ],
      "predicates": {
        "x_new": {
          "meaning": "a pool was constructed",
          "events": [
            "ok:pool::pool"
          ]
        },
        "x_use": {
          "meaning": "the object is used",
          "events": [
            "call:pool::emplace_back",
            "call:pool::wait"
          ]
        }
      },
      "examples": [
        {
          "events": [
            "call:pool::pool",
            "ok:pool::pool",
            "call:pool::emplace_back",
            "ok:pool::emplace_back",
            "call:pool::wait",
            "ok:pool::wait"
          ],
          "allowed": true,
          "reason": "construct, queue a job, wait"
        },
        {
          "events": [
            "call:pool::emplace_back"
          ],
          "allowed": false,
          "reason": "no pool to queue on"
        },
        {
          "events": [
            "call:pool::wait",
            "ok:pool::wait",
            "call:pool::pool",
            "ok:pool::pool"
          ],
          "allowed": false,
          "reason": "waiting before the pool exists"
        }
      ]
    }
