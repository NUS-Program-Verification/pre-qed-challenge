{
  "properties": [
    {
      "id": "jmespath_expression_lifecycle",
      "rule": "jmespath.hpp:971-991,997-1008: jmespath_expression tokenizes in its constructor, stores the result in `error`, and its `tokens` vector holds string_views into the path storage handed to the constructor. read_jmespath(const jmespath_expression&, value, buffer) reads those tokens, so an expression object must exist before it is evaluated; the harness keeps the one expression and the path string it was tokenized from. (A tokenize error does not make evaluation illegal: read_jmespath returns syntax_error for it.)",
      "formula": "(!eval W x_new)",
      "apis": [
        "jmespath_expression::jmespath_expression",
        "read_jmespath"
      ],
      "predicates": {
        "x_new": {
          "meaning": "an expression object was constructed (its tokenize result may be an error)",
          "events": [
            "ok:jmespath_expression::jmespath_expression",
            "fail:jmespath_expression::jmespath_expression"
          ]
        },
        "eval": {
          "meaning": "an expression is about to be evaluated",
          "events": [
            "call:read_jmespath"
          ]
        }
      },
      "examples": [
        {
          "events": [
            "call:jmespath_expression::jmespath_expression",
            "ok:jmespath_expression::jmespath_expression",
            "call:read_jmespath",
            "ok:read_jmespath"
          ],
          "allowed": true,
          "reason": "construct, then evaluate"
        },
        {
          "events": [
            "call:jmespath_expression::jmespath_expression",
            "fail:jmespath_expression::jmespath_expression",
            "call:read_jmespath",
            "fail:read_jmespath"
          ],
          "allowed": true,
          "reason": "a tokenize error is reported as syntax_error by the evaluation"
        },
        {
          "events": [
            "call:read_jmespath"
          ],
          "allowed": false,
          "reason": "no expression to read tokens from"
        }
      ]
    },
    {
      "id": "lazy_json_lifecycle",
      "rule": "json/lazy.hpp:1590-1600: lazy_json(buffer) only stores pointers into the buffer, which 'must remain valid for document lifetime'; lazy.hpp:372,504 and 600-605: every lazy_json_view (root(), operator[], iterator elements) holds a pointer to its lazy_document and into the text; lazy.hpp:789: indexed_lazy_view (view.index()) likewise. So document, view and indexed-view methods need a successfully parsed document whose text is still alive. The harness keeps one text, one document and the views derived from it, and lazy_json drops all of them before it parses new text, so after a call to lazy_json nothing may be used until it succeeds.",
      "formula": "(!x_use W x_new) & G(x_gone -> X(!x_use W x_new))",
      "apis": [
        "lazy_json",
        "lazy_document::root",
        "lazy_document::operator[]",
        "lazy_document::reset_parse_pos",
        "lazy_json_view::operator[]",
        "lazy_json_view::get",
        "lazy_json_view::key",
        "lazy_json_view::index",
        "lazy_json_view::is_object",
        "lazy_json_view::is_array",
        "lazy_json_view::is_string",
        "lazy_json_view::is_number",
        "lazy_json_view::is_boolean",
        "lazy_json_view::is_null",
        "lazy_json_view::has_error",
        "lazy_json_view::error",
        "lazy_json_view::empty",
        "lazy_json_view::size",
        "lazy_json_view::contains",
        "lazy_json_view::read_into",
        "lazy_json_view::begin",
        "lazy_json_view::end",
        "lazy_json_view::raw_json",
        "indexed_lazy_view::size",
        "indexed_lazy_view::empty",
        "indexed_lazy_view::contains",
        "indexed_lazy_view::operator[]",
        "indexed_lazy_view::begin",
        "indexed_lazy_view::end"
      ],
      "predicates": {
        "x_new": {
          "meaning": "a document was parsed",
          "events": [
            "ok:lazy_json"
          ]
        },
        "x_gone": {
          "meaning": "the document, its text and every view of it are dropped before the new text is parsed",
          "events": [
            "call:lazy_json"
          ]
        },
        "x_use": {
          "meaning": "the document or a view derived from it is used",
          "events": [
            "call:lazy_document::root",
            "call:lazy_document::operator[]",
            "call:lazy_document::reset_parse_pos",
            "call:lazy_json_view::operator[]",
            "call:lazy_json_view::get",
            "call:lazy_json_view::key",
            "call:lazy_json_view::index",
            "call:lazy_json_view::is_object",
            "call:lazy_json_view::is_array",
            "call:lazy_json_view::is_string",
            "call:lazy_json_view::is_number",
            "call:lazy_json_view::is_boolean",
            "call:lazy_json_view::is_null",
            "call:lazy_json_view::has_error",
            "call:lazy_json_view::error",
            "call:lazy_json_view::empty",
            "call:lazy_json_view::size",
            "call:lazy_json_view::contains",
            "call:lazy_json_view::read_into",
            "call:lazy_json_view::begin",
            "call:lazy_json_view::end",
            "call:lazy_json_view::raw_json",
            "call:indexed_lazy_view::size",
            "call:indexed_lazy_view::empty",
            "call:indexed_lazy_view::contains",
            "call:indexed_lazy_view::operator[]",
            "call:indexed_lazy_view::begin",
            "call:indexed_lazy_view::end"
          ]
        }
      },
      "examples": [
        {
          "events": [
            "call:lazy_json",
            "ok:lazy_json",
            "call:lazy_document::root",
            "ok:lazy_document::root",
            "call:lazy_json_view::get",
            "ok:lazy_json_view::get"
          ],
          "allowed": true,
          "reason": "parse, take a view, use it"
        },
        {
          "events": [
            "call:lazy_document::root"
          ],
          "allowed": false,
          "reason": "no document yet"
        },
        {
          "events": [
            "call:lazy_json",
            "ok:lazy_json",
            "call:lazy_json",
            "fail:lazy_json",
            "call:lazy_document::root"
          ],
          "allowed": false,
          "reason": "the failed parse dropped the previous document and its text"
        }
      ]
    },
