            "call:cJSONUtils_GenerateMergePatchCaseSensitive",
            "call:cJSONUtils_FindPointerFromObjectTo",
            "call:cJSONUtils_SortObject",
            "call:cJSONUtils_SortObjectCaseSensitive"
          ]
        }
      },
      "examples": [
        {
          "events": [
            "call:cJSON_Parse",
            "ok:cJSON_Parse",
            "call:cJSON_Print",
            "ok:cJSON_Print",
            "call:cJSON_Delete",
            "ok:cJSON_Delete",
            "call:cJSON_ParseWithLength",
            "ok:cJSON_ParseWithLength",
            "call:cJSON_GetArraySize"
          ],
          "allowed": true,
          "reason": "every use sits between a successful parse and the delete"
        },
        {
          "events": [
            "call:cJSON_Parse",
            "ok:cJSON_Parse",
            "call:cJSONUtils_MergePatch",
            "ok:cJSONUtils_MergePatch",
            "call:cJSON_Print"
          ],
          "allowed": true,
          "reason": "merge patch consumed the old root and produced the new one"
        },
        {
          "events": [
            "call:cJSON_Print"
          ],
          "allowed": false,
          "reason": "no tree was parsed"
        },
        {
          "events": [
            "call:cJSON_Parse",
            "fail:cJSON_Parse",
            "call:cJSON_Delete"
          ],
          "allowed": false,
          "reason": "parse failed, there is no tree"
        },
        {
          "events": [
            "call:cJSON_Parse",
            "ok:cJSON_Parse",
            "call:cJSON_Delete",
            "ok:cJSON_Delete",
            "call:cJSON_Print"
          ],
          "allowed": false,
          "reason": "use after cJSON_Delete"
        }
      ]
    },
    {
      "id": "item_ownership",
      "rule": "cJSON.h: cJSON_Create*, cJSON_Duplicate and cJSON_Detach* return a node owned by the caller. cJSON_AddItemTo*, cJSON_InsertItemInArray and cJSON_ReplaceItem* transfer that ownership to the parent on success (cJSON.c add_item_to_array / cJSON_ReplaceItemViaPointer). After the transfer the caller must not pass the node to the library again until it owns a new node. The harness keeps one loose item.",
      "formula": "(!item_use W item_owned) & G(item_given -> X(!item_use W item_owned))",
      "apis": [
        "cJSON_CreateNull",
        "cJSON_CreateTrue",
        "cJSON_CreateFalse",
        "cJSON_CreateBool",
        "cJSON_CreateNumber",
        "cJSON_CreateString",
        "cJSON_CreateRaw",
        "cJSON_CreateArray",
        "cJSON_CreateObject",
        "cJSON_CreateStringReference",
        "cJSON_CreateObjectReference",
        "cJSON_CreateArrayReference",
        "cJSON_CreateIntArray",
        "cJSON_CreateFloatArray",
        "cJSON_CreateDoubleArray",
        "cJSON_CreateStringArray",
        "cJSON_Duplicate",
        "cJSON_DetachItemViaPointer",
        "cJSON_DetachItemFromArray",
        "cJSON_DetachItemFromObject",
        "cJSON_DetachItemFromObjectCaseSensitive",
        "cJSON_AddItemToArray",
        "cJSON_AddItemToObject",
        "cJSON_AddItemToObjectCS",
        "cJSON_InsertItemInArray",
        "cJSON_ReplaceItemViaPointer",
        "cJSON_ReplaceItemInArray",
        "cJSON_ReplaceItemInObject",
        "cJSON_ReplaceItemInObjectCaseSensitive",
        "cJSON_AddItemReferenceToArray",
        "cJSON_AddItemReferenceToObject",
        "cJSON_Compare",
        "cJSONUtils_GeneratePatches",
        "cJSONUtils_GeneratePatchesCaseSensitive",
        "cJSONUtils_GenerateMergePatch",
        "cJSONUtils_GenerateMergePatchCaseSensitive"
      ],
      "predicates": {
        "item_owned": {
          "meaning": "a create, duplicate or detach returned a node the caller owns",
          "events": [
            "ok:cJSON_CreateNull",
            "ok:cJSON_CreateTrue",
            "ok:cJSON_CreateFalse",
            "ok:cJSON_CreateBool",
            "ok:cJSON_CreateNumber",
            "ok:cJSON_CreateString",
            "ok:cJSON_CreateRaw",
            "ok:cJSON_CreateArray",
            "ok:cJSON_CreateObject",
            "ok:cJSON_CreateStringReference",
            "ok:cJSON_CreateObjectReference",
            "ok:cJSON_CreateArrayReference",
            "ok:cJSON_CreateIntArray",
            "ok:cJSON_CreateFloatArray",
            "ok:cJSON_CreateDoubleArray",
            "ok:cJSON_CreateStringArray",
            "ok:cJSON_Duplicate",
            "ok:cJSON_DetachItemViaPointer",
            "ok:cJSON_DetachItemFromArray",
            "ok:cJSON_DetachItemFromObject",
            "ok:cJSON_DetachItemFromObjectCaseSensitive"
          ]
        },
        "item_given": {
          "meaning": "an add, insert or replace accepted the node; the parent now owns it",
          "events": [
            "ok:cJSON_AddItemToArray",
            "ok:cJSON_AddItemToObject",
            "ok:cJSON_AddItemToObjectCS",
            "ok:cJSON_InsertItemInArray",
            "ok:cJSON_ReplaceItemViaPointer",
            "ok:cJSON_ReplaceItemInArray",
            "ok:cJSON_ReplaceItemInObject",
            "ok:cJSON_ReplaceItemInObjectCaseSensitive"
          ]
        },
        "item_use": {
          "meaning": "a routine taking the loose node is about to be called",
          "events": [
            "call:cJSON_AddItemToArray",
            "call:cJSON_AddItemToObject",
            "call:cJSON_AddItemToObjectCS",
            "call:cJSON_InsertItemInArray",
            "call:cJSON_ReplaceItemViaPointer",
            "call:cJSON_ReplaceItemInArray",
            "call:cJSON_ReplaceItemInObject",
            "call:cJSON_ReplaceItemInObjectCaseSensitive",
            "call:cJSON_AddItemReferenceToArray",
            "call:cJSON_AddItemReferenceToObject",
            "call:cJSON_Compare",
            "call:cJSONUtils_GeneratePatches",
            "call:cJSONUtils_GeneratePatchesCaseSensitive",
            "call:cJSONUtils_GenerateMergePatch",
            "call:cJSONUtils_GenerateMergePatchCaseSensitive"
          ]
        }
      },
      "examples": [
        {
          "events": [
            "call:cJSON_CreateNumber",
            "ok:cJSON_CreateNumber",
            "call:cJSON_AddItemToArray",
            "fail:cJSON_AddItemToArray",
            "call:cJSON_AddItemToObject",
            "ok:cJSON_AddItemToObject",
            "call:cJSON_DetachItemFromArray",
            "ok:cJSON_DetachItemFromArray",
            "call:cJSON_Compare"
          ],
          "allowed": true,
          "reason": "a failed add keeps ownership; after the successful add a detach gives a new owned node before the next use"
        },
        {
          "events": [
            "call:cJSON_AddItemToArray"
          ],
          "allowed": false,
          "reason": "no node is owned"
        },
        {
          "events": [
            "call:cJSON_CreateTrue",
            "ok:cJSON_CreateTrue",
            "call:cJSON_AddItemToArray",
            "ok:cJSON_AddItemToArray",
            "call:cJSON_AddItemToArray"
          ],
          "allowed": false,
          "reason": "adding the same node twice after ownership moved"
        },
        {
          "events": [
            "call:cJSON_CreateTrue",
            "ok:cJSON_CreateTrue",
            "call:cJSON_ReplaceItemInArray",
            "ok:cJSON_ReplaceItemInArray",
            "call:cJSON_Compare"
          ],
          "allowed": false,
          "reason": "the node belongs to the tree now"
        }
      ]
    },
    {
      "id": "borrowed_child_validity",
      "rule": "cJSON.h: cJSON_GetArrayItem, cJSON_GetObjectItem*, cJSONUtils_GetPointer* and cJSON_Add*ToObject return pointers owned by the tree. Any mutation of the tree (add, insert, replace, detach, delete, patch, sort, merge) or deleting the tree may free or relink that node, so it must be looked up again before further use.",
      "formula": "(!child_use W child_ok) & G(tree_mutated -> X(!child_use W child_ok))",
      "apis": [
