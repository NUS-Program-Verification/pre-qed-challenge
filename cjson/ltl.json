    {
      "id": "patch_lifecycle",
      "rule": "cJSON_Utils.h: cJSONUtils_ApplyPatches*, cJSONUtils_MergePatch* and cJSONUtils_AddPatchToArray take a patch document returned by cJSONUtils_GeneratePatches* or cJSONUtils_GenerateMergePatch*. The harness keeps one patch.",
      "formula": "!patch_use W patch_ok",
      "apis": [
        "cJSONUtils_GeneratePatches",
        "cJSONUtils_GeneratePatchesCaseSensitive",
        "cJSONUtils_GenerateMergePatch",
        "cJSONUtils_GenerateMergePatchCaseSensitive",
        "cJSONUtils_AddPatchToArray",
        "cJSONUtils_ApplyPatches",
        "cJSONUtils_ApplyPatchesCaseSensitive",
        "cJSONUtils_MergePatch",
        "cJSONUtils_MergePatchCaseSensitive"
      ],
      "predicates": {
        "patch_ok": {
          "meaning": "a patch generator returned a non-NULL document",
          "events": [
            "ok:cJSONUtils_GeneratePatches",
            "ok:cJSONUtils_GeneratePatchesCaseSensitive",
            "ok:cJSONUtils_GenerateMergePatch",
            "ok:cJSONUtils_GenerateMergePatchCaseSensitive"
          ]
        },
        "patch_use": {
          "meaning": "a routine taking the patch document is about to be called",
          "events": [
            "call:cJSONUtils_AddPatchToArray",
            "call:cJSONUtils_ApplyPatches",
            "call:cJSONUtils_ApplyPatchesCaseSensitive",
            "call:cJSONUtils_MergePatch",
            "call:cJSONUtils_MergePatchCaseSensitive"
          ]
        }
      },
      "examples": [
        {
          "events": [
            "call:cJSONUtils_GeneratePatches",
            "ok:cJSONUtils_GeneratePatches",
            "call:cJSONUtils_AddPatchToArray",
            "ok:cJSONUtils_AddPatchToArray",
            "call:cJSONUtils_ApplyPatches"
          ],
          "allowed": true,
          "reason": "patch exists before it is used"
        },
        {
          "events": [
            "call:cJSONUtils_ApplyPatches"
          ],
          "allowed": false,
          "reason": "no patch document"
        },
        {
          "events": [
            "call:cJSONUtils_GenerateMergePatch",
            "fail:cJSONUtils_GenerateMergePatch",
            "call:cJSONUtils_MergePatch"
          ],
          "allowed": false,
          "reason": "generation failed"
        }
      ]
    },
    {
      "id": "print_buffer_free",
      "rule": "cJSON.h: buffers returned by cJSON_Print* and cJSON_malloc must be released with cJSON_free exactly once; freeing when none is held is a double free. The harness keeps one buffer.",
      "formula": "(!free_call W buffer_ok) & G(free_call -> X(!free_call W buffer_ok))",
      "apis": [
        "cJSON_Print",
        "cJSON_PrintUnformatted",
        "cJSON_PrintBuffered",
        "cJSON_malloc",
        "cJSON_free"
      ],
      "predicates": {
        "buffer_ok": {
          "meaning": "a print or cJSON_malloc returned a non-NULL buffer",
          "events": [
            "ok:cJSON_Print",
            "ok:cJSON_PrintUnformatted",
            "ok:cJSON_PrintBuffered",
            "ok:cJSON_malloc"
          ]
        },
        "free_call": {
          "meaning": "cJSON_free is about to be called on the buffer",
          "events": [
            "call:cJSON_free"
          ]
        }
      },
      "examples": [
        {
          "events": [
            "call:cJSON_Print",
            "ok:cJSON_Print",
            "call:cJSON_free",
            "ok:cJSON_free",
            "call:cJSON_malloc",
            "ok:cJSON_malloc",
            "call:cJSON_free"
          ],
          "allowed": true,
          "reason": "each free follows a fresh buffer"
        },
        {
          "events": [
            "call:cJSON_free"
          ],
          "allowed": false,
          "reason": "nothing to free"
        },
        {
          "events": [
            "call:cJSON_Print",
            "ok:cJSON_Print",
            "call:cJSON_free",
            "ok:cJSON_free",
            "call:cJSON_free"
          ],
          "allowed": false,
          "reason": "double free"
        }
      ]
    }
  ]
