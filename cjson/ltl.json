            "ok:cJSON_AddRawToObject",
            "ok:cJSON_AddObjectToObject",
            "ok:cJSON_AddArrayToObject"
          ]
        },
        "child_use": {
          "meaning": "a routine taking the borrowed node is about to be called",
          "events": [
            "call:cJSON_IsInvalid",
            "call:cJSON_IsFalse",
            "call:cJSON_IsTrue",
            "call:cJSON_IsBool",
            "call:cJSON_IsNull",
            "call:cJSON_IsNumber",
            "call:cJSON_IsString",
